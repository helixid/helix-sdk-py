# order-management sample (Python): copy to .env and fill in. The same variables as the JS sample; see README.md.

PORT=3700
HOST=127.0.0.1
# MCP_RESOURCE=http://localhost:3700/mcp

# KYA-OS request proofs (story F-2): verified in-process for SERVICE_DID; the Helix API is never asked.
# SERVICE_DID=did:web:orders.example.com
# KYAOS_TRUSTED_ISSUERS=*
# KYAOS_TRUSTED_ROOTS=
# KYAOS_MAX_CHAIN_LENGTH=10
# KYAOS_CARDS_FILE=
# KYAOS_ALLOW_LOOPBACK_HTTP=1   (development only)

# Audit: the only use of the Helix API, never on the request path
# HELIX_API_URL=http://localhost:3000
# HELIX_API_KEY=

# OAuth: one issuer, several (OAUTH_ISSUERS, JSON), or the local demo tokens
# OAUTH_ISSUER=https://your-tenant.example.com/
DEMO_MODE=1

# KYA-OS session and response proof (story L2-A): the key SERVICE_DID's document lists as key-1.
# SERVICE_SIGNING_KEY=
# KYAOS_PUBLIC_ORIGIN=https://orders.example.com
# KYAOS_CLOCK_SKEW_SECONDS=120
# KYAOS_SESSIONS=1
# KYAOS_SESSION_TTL_MINUTES=30

# The replay store, read by helix_mcp_middleware (nonce_store_from_env).
# memory (default): this process only. redis or dynamo: shared by every instance serving this DID, JS or Python.
# KYAOS_NONCE_STORE=memory
# redis needs redis-py: pip install 'helixid-sdk-py[redis]'
# KYAOS_NONCE_STORE=redis
# KYAOS_REDIS_URL=redis://127.0.0.1:6379
# KYAOS_NONCE_KEY_PREFIX=kyaos:nonce:
# dynamo needs boto3: pip install 'helixid-sdk-py[dynamo]'; AWS credentials come from boto3's own chain.
# KYAOS_NONCE_STORE=dynamo
# KYAOS_DYNAMO_TABLE=kyaos-nonces
# KYAOS_DYNAMO_KEY_ATTRIBUTE=pk
# KYAOS_DYNAMO_TTL_ATTRIBUTE=expiresAt
# KYAOS_DYNAMO_REGION=eu-west-1
# KYAOS_DYNAMO_ENDPOINT=http://127.0.0.1:8000
